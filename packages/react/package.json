{
  "name": "@appricot/react",
  "version": "0.0.0",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "author": "George Gougoudis <george_gougoudis@hotmail.com>",
  "description": "React bindings for @appricot/client: a provider, hooks and a window canvas. The host renders its own chrome.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.build.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "dependencies": {
    "@appricot/client": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.11.0",
    "jsdom": "30.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
