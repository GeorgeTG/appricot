{
  "name": "@app-ricot/demo",
  "version": "0.2.3",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "author": "George Gougoudis <george_gougoudis@hotmail.com>",
  "description": "APPricot's demo host page: draws the streamed windows as its own floating windows, under a strict CSP. Dev-only; never published.",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.build.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run"
  },
  "dependencies": {
    "@app-ricot/client": "workspace:*",
    "@app-ricot/react": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.11.0",
    "jsdom": "30.1.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
