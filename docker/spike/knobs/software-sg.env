# The software scene graph: Qt Quick draws with its raster adaptation instead of OpenGL.
#
# Under Xvfb there is no GPU, so the OpenGL path runs on Mesa's llvmpipe. This knob skips GL
# altogether. What it may buy: less memory and less CPU. What it may break: effects that need
# shaders. It goes into a profile only with a snapshot that proves the application still draws
# correctly (docs/spike/README.md, "Knobs").
#
# QT_QUICK_BACKEND=software selects it
# (https://doc.qt.io/qt-6/qtquick-visualcanvas-adaptations.html, checked 2026-09-23).
QSG_INFO=1
QT_QUICK_BACKEND=software
